{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.freedom.example/work-participation.schema.json",
  "title": "Freedom Work Participation and Benefit Observation — planning revision 2026-09-19",
  "$ref": "#/$defs/ParticipationTerms",
  "$defs": {
    "ParticipationTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "participation_mode",
        "beneficiary",
        "contributor_gain",
        "effort",
        "shared_goal_ref",
        "human_support",
        "completion",
        "reuse",
        "funding",
        "newcomer_friendly"
      ],
      "properties": {
        "schema_version": {
          "const": "freedom.work-participation/v1"
        },
        "participation_mode": {
          "enum": [
            "voluntary_contribution",
            "bounded_mutual_help",
            "funded_work"
          ]
        },
        "beneficiary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "party_ref",
            "problem",
            "intended_gain"
          ],
          "properties": {
            "party_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "problem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "intended_gain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "contributor_gain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description",
            "assurance",
            "resource_refs"
          ],
          "properties": {
            "kind": {
              "enum": [
                "usable_asset",
                "learning",
                "reciprocal_feedback",
                "payment",
                "voluntary_public_good"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "assurance": {
              "enum": [
                "aspirational",
                "available_resource",
                "reserved_human_time",
                "conditional_payment"
              ]
            },
            "resource_refs": {
              "type": "array",
              "maxItems": 30,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "effort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimated_minutes",
            "maximum_minutes"
          ],
          "properties": {
            "estimated_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_minutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "shared_goal_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "human_support": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "promised",
            "reservation_ref",
            "scope",
            "no_capacity_fallback"
          ],
          "properties": {
            "promised": {
              "type": "boolean"
            },
            "reservation_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "no_capacity_fallback": {
              "enum": [
                "self_service",
                "waitlist",
                "offer_smaller_scope"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "promised"
                ],
                "properties": {
                  "promised": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "reservation_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "promised"
                ],
                "properties": {
                  "promised": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "reservation_ref": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criteria",
            "claim_by",
            "finish_by",
            "feedback_due",
            "unanswered_outcome"
          ],
          "properties": {
            "criteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "claim_by": {
              "type": "string",
              "format": "date-time"
            },
            "finish_by": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "feedback_due": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unanswered_outcome": {
              "enum": [
                "expire_unclaimed",
                "close_unconfirmed",
                "contact_accountable_owner"
              ]
            }
          }
        },
        "reuse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visibility",
            "artifact_license_ref",
            "consent_required"
          ],
          "properties": {
            "visibility": {
              "enum": [
                "private",
                "team",
                "community",
                "public"
              ]
            },
            "artifact_license_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "consent_required": {
              "const": true
            }
          }
        },
        "funding": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "payer_ref",
                "budget_ref",
                "budget_state",
                "payment_terms_ref",
                "service_engagement_ref",
                "signed_allocation_ref",
                "settlement_mode"
              ],
              "properties": {
                "payer_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "budget_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "budget_state": {
                  "enum": [
                    "committed",
                    "reserved"
                  ]
                },
                "payment_terms_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "service_engagement_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "signed_allocation_ref": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "settlement_mode": {
                  "enum": [
                    "record_only",
                    "authorized_mandate"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "newcomer_friendly": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "participation_mode"
            ],
            "properties": {
              "participation_mode": {
                "const": "funded_work"
              }
            }
          },
          "then": {
            "properties": {
              "funding": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "payer_ref",
                  "budget_ref",
                  "budget_state",
                  "payment_terms_ref",
                  "service_engagement_ref",
                  "signed_allocation_ref",
                  "settlement_mode"
                ],
                "properties": {
                  "payer_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "budget_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "budget_state": {
                    "enum": [
                      "committed",
                      "reserved"
                    ]
                  },
                  "payment_terms_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "service_engagement_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "signed_allocation_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "settlement_mode": {
                    "enum": [
                      "record_only",
                      "authorized_mandate"
                    ]
                  }
                }
              },
              "contributor_gain": {
                "properties": {
                  "kind": {
                    "const": "payment"
                  },
                  "assurance": {
                    "const": "conditional_payment"
                  }
                }
              },
              "completion": {
                "properties": {
                  "unanswered_outcome": {
                    "const": "contact_accountable_owner"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "participation_mode": {
                "enum": [
                  "voluntary_contribution",
                  "bounded_mutual_help"
                ]
              }
            },
            "required": [
              "participation_mode"
            ]
          },
          "then": {
            "properties": {
              "funding": {
                "type": "null"
              },
              "contributor_gain": {
                "properties": {
                  "kind": {
                    "not": {
                      "const": "payment"
                    }
                  },
                  "assurance": {
                    "not": {
                      "const": "conditional_payment"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "contributor_gain": {
                "properties": {
                  "assurance": {
                    "const": "reserved_human_time"
                  }
                },
                "required": [
                  "assurance"
                ]
              }
            },
            "required": [
              "contributor_gain"
            ]
          },
          "then": {
            "properties": {
              "human_support": {
                "properties": {
                  "promised": {
                    "const": true
                  },
                  "reservation_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "participation_mode": {
                "enum": [
                  "bounded_mutual_help",
                  "funded_work"
                ]
              }
            },
            "required": [
              "participation_mode"
            ]
          },
          "then": {
            "properties": {
              "beneficiary": {
                "properties": {
                  "party_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Immutable terms embedded in the existing WorkItem. Schema-valid references do not prove consent, accepted availability, funding, rights or authorization; owning runtime must validate them.",
      "x-invariants": [
        "maximum_minutes_gte_estimated_minutes",
        "claim_by_lte_finish_by_when_finish_by_present",
        "feedback_due_gte_finish_by_when_both_present",
        "server_validates_capacity_reservation_scope_owner_expiry_and_atomic_remaining",
        "funding_refs_never_prove_cash_received",
        "public_reuse_requires_actual_rights_and_no_private_source_leak",
        "new_terms_revision_never_rewrites_existing_claims_or_A4",
        "funded_work_commencement_requires_the_existing_SOW_and_allocation_signatures"
      ]
    },
    "ParticipationTermsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_ref",
        "participation_terms_revision",
        "participation_terms_sha256",
        "terms"
      ],
      "properties": {
        "work_item_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "participation_terms_revision": {
          "type": "integer",
          "minimum": 1
        },
        "participation_terms_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "terms": {
          "$ref": "#/$defs/ParticipationTerms"
        }
      },
      "x-digest": "SHA-256 of RFC 8785/JCS serialized ParticipationTerms object only; lowercase hex. Runtime cross-language vectors not implemented in this package."
    },
    "BenefitObservationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_claim_ref",
        "role",
        "outcome",
        "actual_gain",
        "evidence_refs",
        "would_participate_again",
        "effort_minutes",
        "supersedes_observation_ref"
      ],
      "properties": {
        "work_claim_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "beneficiary",
            "contributor"
          ]
        },
        "outcome": {
          "enum": [
            "gained",
            "partly_gained",
            "not_gained",
            "unconfirmed"
          ]
        },
        "actual_gain": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "would_participate_again": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "effort_minutes": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform_maintenance",
                "coordination_friction",
                "collaborative_value",
                "paid_delivery"
              ],
              "properties": {
                "platform_maintenance": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "coordination_friction": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "collaborative_value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "paid_delivery": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes_observation_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "gained",
                  "partly_gained"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "actual_gain": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      ],
      "description": "Voluntary first-person benefit report. Reporter is server-derived; participant relation is server-checked. Not a QC, A4, acceptance, payable or evidence of cash receipt. Null effort is unknown, not zero."
    },
    "BenefitObservationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "work_item_ref",
        "reporter_principal_ref",
        "observation_revision",
        "recorded_at",
        "report"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "work_item_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reporter_principal_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observation_revision": {
          "type": "integer",
          "minimum": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "report": {
          "$ref": "#/$defs/BenefitObservationRequest"
        }
      }
    }
  }
}
