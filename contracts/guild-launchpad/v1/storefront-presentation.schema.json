{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freetwai.com/contracts/guild-launchpad/v1/storefront-presentation",
  "description": "Additive saved store presentation. Existing storefront/v1 content, releases and capabilities remain unchanged.",
  "$defs": {
    "appearance-input": {
      "type": "object",
      "properties": {
        "template_id": {
          "type": "string",
          "enum": [
            "catalog-grid-v1",
            "catalog-list-v1"
          ]
        }
      },
      "required": [
        "template_id"
      ],
      "additionalProperties": false,
      "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: none."
    },
    "appearance": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "const": "freedom.hosted-store-presentation/v1"
        },
        "template_id": {
          "type": "string",
          "enum": [
            "catalog-grid-v1",
            "catalog-list-v1"
          ]
        },
        "published_template_id": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "catalog-grid-v1",
                "catalog-list-v1"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])"
        }
      },
      "required": [
        "profile",
        "template_id",
        "published_template_id",
        "version"
      ],
      "additionalProperties": false,
      "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: current_same_instance_store_capability, profile_version_cas."
    }
  }
}
