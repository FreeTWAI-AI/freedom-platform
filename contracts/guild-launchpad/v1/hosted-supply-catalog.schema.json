      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "currency": {
          "type": "string",
          "enum": [
            "TWD",
            "USD"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$"
        }
      },
      "required": [
        "name",
        "currency"
      ],
      "additionalProperties": false,
      "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: none."
    },
    "setup-receipt": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
