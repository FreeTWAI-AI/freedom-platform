        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$"
