{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freetwai.com/contracts/guild-launchpad/v1/hosted-supply-catalog",
  "description": "Private supplier preparation without retail activation; existing inventory and consent authority.",
  "$defs": {
