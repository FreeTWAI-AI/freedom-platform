        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$"
        },
        "stock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "cost_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
