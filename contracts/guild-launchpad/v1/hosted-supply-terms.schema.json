{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freetwai.com/contracts/guild-launchpad/v1/hosted-supply-terms",
  "description": "Private supplier terms on the existing inventory item. No supply offer, acceptance or transaction is enabled.",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "cost_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "shipping_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "shipping_terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$"
        },
        "return_terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$"
        }
      },
      "required": [
        "cost_minor",
        "shipping_minor",
        "shipping_terms",
        "return_terms"
      ],
      "additionalProperties": false,
      "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: current_same_instance_store_write_capability, product_version_cas."
    },
    "view": {
      "type": "object",
      "properties": {
        "cost_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "shipping_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "shipping_terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$"
        },
        "return_terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$"
        },
        "product_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "currency": {
          "type": "string",
          "enum": [
            "TWD",
            "USD"
          ]
        },
        "stock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "available": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "version": {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])"
        },
        "transaction_state": {
          "type": "string",
          "const": "not_enabled"
        }
      },
      "required": [
        "cost_minor",
        "shipping_minor",
        "shipping_terms",
        "return_terms",
        "product_id",
        "currency",
        "stock",
        "reserved",
        "available",
        "version",
        "transaction_state"
      ],
      "additionalProperties": false,
      "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: available_equals_stock_minus_reserved, private_cost_and_terms."
    }
  }
}
