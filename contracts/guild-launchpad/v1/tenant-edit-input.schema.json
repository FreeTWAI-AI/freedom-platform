{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "public_slug": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "display_name",
    "public_slug"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/guild-launchpad/v1/tenant-edit-input",
  "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: display_name_control_character."
}
