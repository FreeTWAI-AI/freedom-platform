  "description": "Commerce release and account setup. No payment execution authority.",
  "$defs": {
    "empty-input": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: none."
    },
    "store-release": {
      "type": "object",
      "properties": {
        "module_release_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "application_release_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])"
        },
        "capabilities": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upgrade": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "module_release_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "application_release_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "module_release_ref",
                "application_release_ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "can_upgrade": {
          "type": "boolean"
        }
      },
      "required": [
        "module_release_ref",
        "application_release_ref",
        "version",
        "capabilities",
        "upgrade",
        "can_upgrade"
      ],
      "additionalProperties": false,
      "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: current_instance_release_and_authority."
    },
    "provider-account-create-input": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "ecpay"
        },
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "live"
          ]
        },
        "merchant_id": {
          "type": "string",
          "pattern": "^[0-9]{7,10}$"
        },
        "fresh_auth_verification_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "provider",
        "environment",
        "merchant_id",
        "fresh_auth_verification_id"
      ],
      "additionalProperties": false,
      "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: fresh_auth_required, host_provider_environment."
    },
    "provider-service-put-input": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "ecpay.aio.credit.v1",
            "ecpay.logistics.domestic.v1",
            "ecpay.invoice.b2c.v1"
          ]
        },
        "hash_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{16}$"
        },
        "hash_iv": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{16}$"
        },
        "credit_check_code": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "fresh_auth_verification_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
