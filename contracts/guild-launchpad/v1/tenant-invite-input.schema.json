{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "invitee_principal_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "operator",
        "viewer"
      ]
    },
    "instance_capabilities": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "capabilities": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[a-z][a-z0-9_.:-]{0,159}$(?![\\s\\S])"
            }
          }
        },
        "required": [
          "instance_id",
          "capabilities"
        ],
        "additionalProperties": false
      }
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
    }
  },
  "required": [
    "invitee_principal_id",
    "role",
    "instance_capabilities",
    "expires_at"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/guild-launchpad/v1/tenant-invite-input",
  "description": "Structural shape only. The server decides identity, membership, capability, current version and quotas. Server-only rules: instance_ids_unique, instance_capability_keys_unique."
}
