{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "broker-credential.envelope/v1"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "wrapNonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "ciphertext": {
      "type": "string",
      "minLength": 23,
      "maxLength": 5483,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "wrappedDek": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    }
  },
  "required": [
    "profile",
    "keyId",
    "nonce",
    "wrapNonce",
    "ciphertext",
    "wrappedDek"
  ],
  "additionalProperties": false,
  "description": "Closed broker-internal structural data only. No raw secret, model readiness, decryption or execution authority is established by parsing.",
  "$id": "https://freetwai.com/contracts/execution/v2/broker-credential-envelope"
}
