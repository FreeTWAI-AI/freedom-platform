    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    }
  },
  "required": [
    "profile",
    "credentialId",
    "generation",
    "modelConnectionId",
    "modelVersion",
    "ownerUserId",
    "ownerPrincipalId",
    "scopeId",
    "environment",
    "clientId",
    "runtimeDeviceId",
    "connectionId",
    "familyId",
    "selection",
    "recoveryGeneration",
    "issuedAt",
    "expiresAt"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v2/model-credential-binding",
  "description": "Closed broker-internal structural data only. No raw secret, model readiness, decryption or execution authority is established by parsing."
}
