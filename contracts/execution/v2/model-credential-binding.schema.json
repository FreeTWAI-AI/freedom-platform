          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
        },
        "processingLocation": {
          "type": "string",
          "const": "provider_remote"
        },
        "artifactCustody": {
          "type": "string",
          "const": "platform_asset"
        },
        "credentialCustody": {
          "type": "string",
          "const": "platform_vault"
        },
        "engineLocation": {
          "type": "string",
          "const": "platform"
        },
        "billingSource": {
          "type": "string",
          "const": "user_byok"
        }
      },
      "required": [
        "providerRef",
        "modelRef",
        "processingLocation",
        "artifactCustody",
        "credentialCustody",
        "engineLocation",
        "billingSource"
