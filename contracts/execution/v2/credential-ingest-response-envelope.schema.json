{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "response": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$(?![\\s\\S])"
    }
  },
  "required": [
    "response"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v2/credential-ingest-response-envelope",
  "description": "Closed metadata/reference-only credential ingestion shape. No secret, capture readiness, private intent or operational authority."
}
