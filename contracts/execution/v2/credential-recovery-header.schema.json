{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "alg": {
      "type": "string",
      "const": "EdDSA"
    },
    "typ": {
      "type": "string",
      "const": "freedom-credential-recovery+jws"
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
    }
  },
  "required": [
    "alg",
    "typ",
    "kid"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v2/credential-recovery-header",
  "description": "Closed broker-internal structural data only. No raw secret, model readiness, decryption or execution authority is established by parsing."
}
