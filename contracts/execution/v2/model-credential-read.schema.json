{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "credentialId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "credentialId"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v2/model-credential-read",
  "description": "Closed broker-internal structural data only. No raw secret, model readiness, decryption or execution authority is established by parsing."
}
