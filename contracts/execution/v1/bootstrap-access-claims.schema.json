{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sub": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "owner_user_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runtime_device_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "connection_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "connection_version": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^[1-9][0-9]{0,18}$(?![\\s\\S])"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "staging-next",
        "next"
      ]
    },
    "purpose": {
      "type": "string",
      "const": "bootstrap_access"
    },
    "scope": {
      "type": "string",
      "const": "bootstrap.status.read"
    },
    "cnf": {
      "type": "object",
      "properties": {
        "jkt": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"
        }
      },
      "required": [
        "jkt"
      ],
      "additionalProperties": false
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jti": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    }
  },
  "required": [
    "iss",
    "aud",
    "sub",
    "owner_user_id",
    "scope_id",
    "runtime_device_id",
    "connection_id",
    "connection_version",
    "client_id",
    "environment",
    "purpose",
    "scope",
    "cnf",
    "iat",
    "exp",
    "jti"
  ],
  "additionalProperties": false,
  "description": "Structural bootstrap crypto profile only. The server verifier checks signatures, trusted issuer/key purpose and validity, exact host identity/URI/binding, canonical encoding, signed-64-bit version and time bounds. Caller-provided keys/time/binding are not authenticated by this schema. No current DB authority, nonce consumption, replay prevention, machine authentication or execution permission.",
  "$id": "https://freetwai.com/contracts/execution/v1/bootstrap-access-claims"
}
