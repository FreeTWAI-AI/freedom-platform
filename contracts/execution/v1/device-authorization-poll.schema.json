          "type": "integer",
          "minimum": 5,
          "maximum": 325,
          "description": "Seconds; initial 5 plus at most 64 accepted proof slowdowns of 5 seconds."
        },
        "operational_authority": {
          "type": "boolean",
          "const": false
        }
      },
