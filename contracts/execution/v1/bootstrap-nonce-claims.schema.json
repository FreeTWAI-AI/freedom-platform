{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "const": "bootstrap_nonce"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "staging-next",
        "next"
      ]
    },
    "connection_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "jti": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "htm": {
      "type": "string",
      "const": "POST"
    },
    "htu": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ath": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"
    }
  },
  "required": [
    "purpose",
    "client_id",
    "environment",
    "connection_id",
    "jti",
    "iat",
    "htm",
    "htu",
    "ath"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v1/bootstrap-nonce-claims",
  "description": "Closed bootstrap session shape only. Real signatures, exact host and current DB authority, time, replay and committed rotation must be independently checked. No execution authority or approved production trust."
}
