{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "userCode": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{5}-[0-9A-HJKMNP-TV-Z]{5}$(?![\\s\\S])"
    },
    "authorizationId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "requestDigest": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "deny"
      ]
    }
  },
  "required": [
    "userCode",
    "authorizationId",
    "requestDigest",
    "decision"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v1/bootstrap-http-decision",
  "description": "Closed HTTP body shape only. Transport must separately enforce origin, credential kind, real proof and current DB authority. No execution authority or production trust."
}
