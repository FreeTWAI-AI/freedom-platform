{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "const": "device_pairing_begin"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "staging-next",
        "next"
      ]
    },
    "runtime_kind": {
      "type": "string",
      "enum": [
        "agent-kit",
        "extension",
        "neo"
      ]
    },
    "scope": {
      "type": "string",
      "const": "bootstrap.status.read"
    },
    "jti": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "htm": {
      "type": "string",
      "const": "POST"
    },
    "htu": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "purpose",
    "client_id",
    "environment",
    "runtime_kind",
    "scope",
    "jti",
    "iat",
    "htm",
    "htu"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v1/device-pairing-begin-claims",
  "description": "Closed pairing claim shape only. Real signatures, exact host and DB binding, current time, approval, replay and single consumption must be verified by the trusted service. Not OAuth transport compatibility or execution authority."
}
