{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keyThumbprint": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"
    },
    "proofId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "validFromMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "validUntilMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assurance": {
      "type": "string",
      "const": "cryptographic_only"
    },
    "operational_authority": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "keyThumbprint",
    "proofId",
    "issuedAt",
    "validFromMs",
    "validUntilMs",
    "assurance",
    "operational_authority"
  ],
  "additionalProperties": false,
  "description": "Signature and exact supplied binding evidence only; host clock/binding are not authenticated, no replay prevention or current DB authority.",
  "$id": "https://freetwai.com/contracts/execution/v1/device-pairing-proof-result"
}
