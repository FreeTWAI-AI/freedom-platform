{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connectionId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "official_cli"
            },
            "engineLocation": {
              "type": "string",
              "const": "runtime_local"
            },
            "billingSource": {
              "type": "string",
              "const": "user_cli"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "local_keychain"
            },
            "engineLocation": {
              "type": "string",
              "const": "runtime_local"
            },
            "billingSource": {
              "type": "string",
              "const": "user_byok"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "platform_vault"
            },
            "engineLocation": {
              "type": "string",
              "const": "platform"
            },
            "billingSource": {
              "type": "string",
              "const": "user_byok"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Explicit member selection metadata only. Provider, model, processing/custody and billing labels are not authentication, verified availability, or operational support. No automatic fallback."
    }
  },
  "required": [
    "connectionId",
    "selection"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v1/member-execution-http-model-create",
  "description": "Closed member execution HTTP body shape only. Transport separately checks current member authentication, exact Origin/CSRF, idempotency and primary If-Match CAS. No model or operational execution authority."
}
