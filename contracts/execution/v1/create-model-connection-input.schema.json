{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "connectionId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expectedConnectionVersion": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])"
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "official_cli"
            },
            "engineLocation": {
              "type": "string",
              "const": "runtime_local"
            },
            "billingSource": {
              "type": "string",
              "const": "user_cli"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "local_keychain"
            },
            "engineLocation": {
              "type": "string",
              "const": "runtime_local"
            },
            "billingSource": {
              "type": "string",
              "const": "user_byok"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "platform_vault"
            },
            "engineLocation": {
              "type": "string",
              "const": "platform"
            },
            "billingSource": {
              "type": "string",
              "const": "user_byok"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Explicit member selection metadata only. Provider, model, processing/custody and billing labels are not authentication, verified availability, or operational support. No automatic fallback."
    }
  },
  "required": [
    "key",
    "connectionId",
    "selection"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v1/create-model-connection-input",
  "description": "Closed member execution prerequisite shape only. Server revalidates current identity, backing bindings, versions, consent, expiry and policy. Parsing never grants model or operational execution authority."
}
