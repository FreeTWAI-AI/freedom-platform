{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "modelConnectionId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "connectionId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runtimeDeviceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "familyId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "staging-next",
        "next"
      ]
    },
    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "official_cli"
            },
            "engineLocation": {
              "type": "string",
              "const": "runtime_local"
            },
            "billingSource": {
              "type": "string",
              "const": "user_cli"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "local_keychain"
            },
            "engineLocation": {
              "type": "string",
              "const": "runtime_local"
            },
            "billingSource": {
              "type": "string",
              "const": "user_byok"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "providerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "modelRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "processingLocation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
            },
            "artifactCustody": {
              "type": "string",
              "enum": [
                "runtime_local",
                "platform_asset"
              ]
            },
            "credentialCustody": {
              "type": "string",
              "const": "platform_vault"
            },
            "engineLocation": {
              "type": "string",
              "const": "platform"
            },
            "billingSource": {
              "type": "string",
              "const": "user_byok"
            }
          },
          "required": [
            "providerRef",
            "modelRef",
            "processingLocation",
            "artifactCustody",
            "credentialCustody",
            "engineLocation",
            "billingSource"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Explicit member selection metadata only. Provider, model, processing/custody and billing labels are not authentication, verified availability, or operational support. No automatic fallback."
    },
    "state": {
      "type": "string",
      "enum": [
        "unverified",
        "revoked"
      ]
    },
    "aggregateVersion": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "operational_authority": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "modelConnectionId",
    "connectionId",
    "runtimeDeviceId",
    "familyId",
    "environment",
    "clientId",
    "selection",
    "state",
    "aggregateVersion",
    "createdAt",
    "operational_authority"
  ],
  "additionalProperties": false,
  "description": "Closed member-selected model connection metadata. Unverified records do not contain provider credentials or model authorization. Parsing does not verify current database authority.",
  "$id": "https://freetwai.com/contracts/execution/v1/model-connection-metadata"
}
