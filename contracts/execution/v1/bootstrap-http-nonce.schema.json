{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connectionId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "connectionId"
  ],
  "additionalProperties": false,
  "$id": "https://freetwai.com/contracts/execution/v1/bootstrap-http-nonce",
  "description": "Closed HTTP body shape only. Transport must separately enforce origin, credential kind, real proof and current DB authority. No execution authority or production trust."
}
