{
  "format": "freedom.module/v1",
  "module_id": "work",
  "owner_role": "foundation",
  "owned_paths": [
    "modules/opportunity-project-work/**",
    "apps/platform-api/src/platform-app.ts",
    "apps/platform-api/src/member-boundary.ts",
    "apps/platform-api/src/routes/private-work.ts",
    "apps/platform-api/src/routes/tenant-work.ts",
    "contracts/guild-launchpad/v1/tenant-work.ts",
    "modules/community/task-board.ts",
    "modules/results/benefits.ts",
    "migrations/077_work_scope_privacy.sql",
    "migrations/081_private_work_commands.sql",
    "migrations/084_private_work_result_profiles.sql",
    "tests/runtime/work-privacy.test.ts",
    "tests/runtime/private-work-commands.test.ts",
    "tests/runtime/private-result-schema.test.ts",
    "tests/runtime/private-result-races.test.ts",
    "apps/portal-web/src/modules/MemberTasks.tsx",
    "tests/runtime/flows.test.ts",
    "apps/portal-web/src/modules/WorkbenchPanel.tsx",
    "apps/portal-web/src/modules/ShowcasePanel.tsx",
    "apps/portal-web/src/modules/EngagementPanel.tsx",
    "scripts/verify-guild-work.mjs",
    "tests/runtime/verify-guild-work.test.ts"
  ],
  "public_exports": [
    "modules/opportunity-project-work/work.ts",
    "modules/opportunity-project-work/private-work.ts",
    "modules/opportunity-project-work/private-commands.ts"
  ],
  "dependencies": [
    "command-core",
    "resource-scopes",
    "scoped-commands"
  ],
  "contract_families": [
    "preview",
    "common"
  ],
  "client_profiles": [
    "member"
  ],
  "instructions": [
    "modules/opportunity-project-work/README.md",
    "modules/opportunity-project-work/results-schema.md",
    "docs/platform-plan/execution/unified-foundation/00-baseline-and-decisions.md",
    "docs/platform-plan/execution/unified-foundation/02-principal-command.md",
    "docs/platform-plan/execution/unified-foundation/03-assets-private-work.md",
    "docs/platform-plan/execution/unified-foundation/04-execution-adapters-release.md"
  ],
  "invariants": [
    "current-authority-before-replay",
    "no-secrets-in-artifacts"
  ],
  "tests": [
    "runtime.work",
    "runtime.work-privacy",
    "runtime.full"
  ],
  "surfaces": [
    {
      "surface_id": "work.private-read-api",
      "kind": "http",
      "entry": "apps/platform-api/src/routes/private-work.ts",
      "operations": [
        "work.private.list",
        "work.private.read"
      ],
      "auth_profile": "member-session"
    },
    {
      "surface_id": "work.legacy-api",
      "kind": "http",
      "entry": "apps/platform-api/src/platform-app.ts",
      "operations": [
        "work.list",
        "work.create",
        "work.claim",
        "work.claim.update"
      ],
      "auth_profile": "member-session"
    },
    {
      "surface_id": "work.member-tasks",
      "kind": "page",
      "entry": "apps/portal-web/src/modules/MemberTasks.tsx",
      "operations": [
        "work.list",
        "work.create"
      ],
      "auth_profile": "member-session"
    },
    {
      "surface_id": "work.workbench-page",
      "kind": "page",
      "entry": "apps/portal-web/src/modules/WorkbenchPanel.tsx",
      "operations": [
        "work.list",
        "work.create",
        "work.claim",
        "work.claim.update"
      ],
      "auth_profile": "member-session"
    },
    {
      "surface_id": "work.showcase-page",
      "kind": "page",
      "entry": "apps/portal-web/src/modules/ShowcasePanel.tsx",
      "operations": [
        "showcase.list",
        "showcase.publish",
        "opportunity.propose",
        "engagement.propose"
      ],
      "auth_profile": "member-session"
    },
    {
      "surface_id": "work.engagement-page",
      "kind": "page",
      "entry": "apps/portal-web/src/modules/EngagementPanel.tsx",
      "operations": [
        "engagement.list",
        "engagement.agree",
        "engagement.deliver",
        "engagement.accept",
        "engagement.receipt.report",
        "engagement.receipt.confirm"
      ],
      "auth_profile": "member-session"
    },
    {
      "surface_id": "work.tenant-api",
      "kind": "http",
      "entry": "apps/platform-api/src/routes/tenant-work.ts",
      "operations": [
        "work.tenant.list",
        "work.tenant.read",
        "work.tenant.create",
        "work.tenant.update",
        "work.tenant.archive",
        "work.tenant.prepare",
        "work.tenant.write",
        "work.tenant.finalize"
      ],
      "auth_profile": "member-session"
    }
  ]
}
