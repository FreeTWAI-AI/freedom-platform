{
  "schema": "freedom.cloudflare-migration-plan/v1",
  "phase": "preflight",
  "status": "planned_not_provisioned",
  "zone": "freetwai.com",
  "notes": "Runtime DB connections come only from the Hyperdrive binding; migrator credentials stay in the operator private directory. Names only. No resource in this file exists until a reviewed provisioning phase records its provider ID in a private evidence file. Prices are the 2026-09-24 public catalog snapshot, not a quote or purchase.",
  "protected": {
    "hostnames": ["freetwai.com", "staging.freetwai.com"],
    "hostname_policy": "Every hostname in the zone except the candidate hostnames below is protected; tools deny by default.",
    "tunnels": "all-existing",
    "access_applications": ["Freedom public administrators", "Freedom staging", "Freedom staging administrators"],
    "r2_buckets": "all-existing",
    "local": {
      "ports": [4310, 4312, 54339],
      "systemd_user_units": [
        "freedom-public.service",
        "freedom-public-backup.service",
        "freedom-public-backup.timer",
        "freedom-staging.service",
        "freedom-staging-backup.service",
        "freedom-staging-backup.timer",
        "freedom-staging-tunnel.service"
      ],
      "databases": ["freedom_local", "freedom_staging", "freedom_public"],
      "paths": [
        "~/.local/share/freedom-public",
        "~/.local/share/freedom-staging",
        "~/.config/freedom-public",
        "~/.config/freedom-staging",
        "~/.local/state/freedom-public",
        "~/.local/state/freedom-staging"
      ]
    }
  },
  "database_defaults": {
    "provider": "planetscale",
    "engine": "postgresql",
    "major_version": 18,
    "catalog_checked_at": "2026-09-24",
    "catalog_source": "https://planetscale.com/pricing.md?region=ap-northeast",
    "region_preference": [
      {"provider": "aws", "region": "ap-northeast-1", "pscale_slug": "ap-northeast", "label": "Tokyo", "reason": "closest listed PlanetScale Postgres region to Taiwan users; confirm latency from Castle and Workers placement before purchase"},
      {"provider": "gcp", "region": "asia-northeast3", "pscale_slug": "gcp-asia-northeast3", "label": "Seoul", "reason": "fallback if Tokyo SKU or Hyperdrive latency is unsuitable"},
      {"provider": "aws", "region": "ap-southeast-1", "pscale_slug": "ap-southeast", "label": "Singapore", "reason": "second fallback"}
    ],
    "monthly_budget_usd": {"engineering_estimate_low": 50, "engineering_estimate_high": 100, "database_base_cap_without_new_approval": 60},
    "extensions_required": [],
    "migrations": {"first": 1, "last": 37, "known_gaps": [22], "ledger_table": "schema_migrations"}
  },
  "environments": {
    "staging-next": {
      "purpose": "Independent synthetic-data staging for the Workers runtime. Never receives live member data.",
      "hostname": "staging-next.freetwai.com",
      "freedom_env": "staging",
      "data_source": "synthetic",
      "worker": {"name": "freedom-platform-staging-next", "workers_dev": false, "preview_urls": false},
      "access": {"application_name": "Freedom staging-next", "admin_application_name": "Freedom staging-next administrators", "required": true},
      "hyperdrive": [
        {"name": "freedom-staging-next-fresh", "binding": "DB_FRESH", "caching_disabled": true, "use": "all authenticated, session, permission, write and read-after-write queries"},
        {"name": "freedom-staging-next-cached", "binding": "DB_CACHED", "caching_disabled": false, "max_age_seconds": 30, "optional": true, "use": "public catalog display only; never sessions, permissions or member data"}
      ],
      "database": {
        "name": "freedom-staging-next",
        "branch": "main",
        "topology": "single_node",
        "sku": "PS-5",
        "architecture": "arm64",
        "catalog_monthly_usd": 5,
        "roles": {"migrator": "freedom_staging_next_migrator", "runtime": "freedom_staging_next_app"}
      },
      "r2_buckets": [{"name": "freedom-staging-next-private", "public": false, "optional": true}],
      "secret_names": ["GITHUB_SOCIAL_TOKEN_KEY", "FREEDOM_ADMIN_CSRF_SECRET"],
      "var_names": ["APP_ORIGIN", "FREEDOM_ENV", "FREEDOM_DATABASE_NAME", "FREEDOM_REGISTRATION_COMMUNITY_ID", "FREEDOM_ADMIN_ACCESS_ISSUER", "FREEDOM_ADMIN_ACCESS_AUD"]
    },
    "next": {
      "purpose": "Production candidate. Protected by Access during rehearsal; becomes production only after the reviewed cutover.",
      "hostname": "next.freetwai.com",
      "freedom_env": "public",
      "data_source": "rehearsal-restore-of-public-backup",
      "worker": {"name": "freedom-platform-next", "workers_dev": false, "preview_urls": false},
      "access": {"application_name": "Freedom next candidate", "admin_application_name": "Freedom next administrators", "required": true},
      "hyperdrive": [
        {"name": "freedom-next-fresh", "binding": "DB_FRESH", "caching_disabled": true, "use": "all authenticated, session, permission, write and read-after-write queries"},
        {"name": "freedom-next-cached", "binding": "DB_CACHED", "caching_disabled": false, "max_age_seconds": 30, "optional": true, "use": "public catalog display only; never sessions, permissions or member data"}
      ],
      "database": {
        "name": "freedom-next",
        "branch": "main",
        "topology": "ha",
        "sku": "PS-5",
        "architecture": "arm64",
        "catalog_monthly_usd": 15,
        "resize_gate": {"sku": "PS-10", "catalog_monthly_usd": 41, "only_if": "load test or connection limits fail on PS-5 HA"},
        "roles": {"migrator": "freedom_next_migrator", "runtime": "freedom_next_app"}
      },
      "r2_buckets": [{"name": "freedom-next-private", "public": false, "optional": true}],
      "secret_names": ["GITHUB_SOCIAL_TOKEN_KEY", "FREEDOM_ADMIN_CSRF_SECRET"],
      "var_names": ["APP_ORIGIN", "FREEDOM_ENV", "FREEDOM_DATABASE_NAME", "FREEDOM_REGISTRATION_COMMUNITY_ID", "FREEDOM_ADMIN_ACCESS_ISSUER", "FREEDOM_ADMIN_ACCESS_AUD"]
    }
  }
}
