-- Opt-in only, after 096. Separate from both ordinary app and cipher custody.
-- Provision <env_prefix>_broker_executor LOGIN NOSUPERUSER NOCREATEDB
-- NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT, with no memberships.
-- Run only as the schema migrator. No role passwords, key or installed host.
\set executor :env_prefix '_broker_executor'
BEGIN;
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM :"executor";
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM :"executor";
SELECT format('REVOKE ALL PRIVILEGES (%s) ON TABLE %s FROM %I;',
  (SELECT string_agg(quote_ident(a.attname),',' ORDER BY a.attnum) FROM pg_catalog.pg_attribute a
    WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped),c.oid::regclass,:'executor')
FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname='public' AND c.relkind='r'
\gexec
GRANT USAGE ON SCHEMA public TO :"executor";
-- Actual joined current authority, immutable model/Grant/approval/Attempt and
-- retained quota/Result index reads used by the existing broker domain chain.
GRANT SELECT ON users,sessions,principals,resource_scopes,runtime_registration_challenges,
  runtime_registrations,agent_connections,bootstrap_refresh_families,model_connections,
  broker_model_credentials,model_broker_authorizations,execution_grants,execution_runs,
  execution_attempts,model_export_approvals,model_text_steps,work_items,
  private_work_persistence_policy,model_inference_export_policy,assets,asset_objects,
  asset_upload_intents,private_work_results,private_model_work_results,private_work_result_index,private_work_result_catalog,
  private_work_result_targets,scoped_command_receipts,scoped_transition_journal,scoped_outbox TO :"executor";
-- PostgreSQL row locks require UPDATE on at least one column. These columns
-- preserve existing invoker/trigger semantics; no identity/binding rewrites.
GRANT UPDATE(active) ON users TO :"executor";
GRANT UPDATE(revoked_at) ON sessions TO :"executor";
GRANT UPDATE(status) ON principals,resource_scopes TO :"executor";
GRANT UPDATE(consumed_at) ON runtime_registration_challenges TO :"executor";
GRANT UPDATE(state) ON runtime_registrations,agent_connections,
  bootstrap_refresh_families,model_connections,execution_grants,execution_attempts,model_export_approvals TO :"executor";
GRANT UPDATE(scope_kind) ON private_work_persistence_policy,model_inference_export_policy TO :"executor";
GRANT UPDATE(accepted_at) ON model_broker_authorizations TO :"executor";
GRANT UPDATE(aggregate_version) ON work_items TO :"executor";
GRANT UPDATE(state,aggregate_version,task_lease_epoch,current_attempt_id) ON execution_runs TO :"executor";
GRANT INSERT(attempt_id,run_id,work_item_id,owner_user_id,owner_principal_id,scope_id,grant_id,
  attempt_number,grant_snapshot,state,blockers,activation_binding,created_at) ON execution_attempts TO :"executor";
GRANT INSERT(step_id,attempt_id,intent_id,approval_id,run_id,work_item_id,owner_user_id,owner_principal_id,
  scope_id,environment,client_id,binding,verified_binding,evidence_origin,activated_run_version,
  task_lease_epoch,control_epoch,context_sha256,input_byte_size,max_output_tokens,creation_key,created_at,lease_expires_at)
  ON model_text_steps TO :"executor";
GRANT UPDATE(state,aggregate_version,usage_status,dispatched_at,permit_expires_at,verified_binding,
  observation,observed_at,reservation_held,result_id) ON model_text_steps TO :"executor";
-- Only the existing private model Result lifecycle. Human Result creation,
-- avatar pointers, Asset retirement/deletion/maintenance are not granted.
GRANT INSERT(asset_id,scope_id,owner_principal_id,owner_user_id,policy_revision,representation_id,purpose) ON assets TO :"executor";
GRANT UPDATE(state,ready_at) ON assets TO :"executor";
GRANT INSERT(intent_id,asset_id,representation_id,scope_id,owner_principal_id,target_user_id,policy_revision,
  prepare_key,request_digest,source_content_type,source_byte_size,source_sha256,expected_version,expires_at,
  purpose,reserved_bytes,target_kind,target_work_id) ON asset_upload_intents TO :"executor";
GRANT UPDATE(fence,lease_token,lease_expires_at,state,finalized_at) ON asset_upload_intents TO :"executor";
GRANT INSERT(asset_id,scope_id,representation_id,content_type,byte_size,content_sha256,transform_version,
  policy_revision,purpose,variant) ON asset_objects TO :"executor";
GRANT INSERT(result_id,intent_id,step_id) ON private_model_work_results TO :"executor";
GRANT INSERT(result_id,provenance,work_item_id,scope_id,owner_principal_id,owner_user_id,asset_id,work_version,revision)
  ON private_work_result_index TO :"executor";
GRANT INSERT(work_item_id,scope_id,owner_principal_id,owner_user_id,result_id,asset_id,linked_at_work_version)
  ON private_work_result_targets TO :"executor";
GRANT UPDATE(result_id,asset_id,linked_at_work_version) ON private_work_result_targets TO :"executor";
GRANT INSERT(principal_id,authn_kind,scope_id,operation,idempotency_key,principal_kind,scope_kind,target_kind,
  target_id,request_sha256,response) ON scoped_command_receipts TO :"executor";
GRANT INSERT(transition_id,scope_id,scope_kind,principal_id,principal_kind,authn_kind,aggregate_type,
  aggregate_id,aggregate_version,operation,data) ON scoped_transition_journal TO :"executor";
GRANT INSERT(event_id,transition_id,scope_id,scope_kind,event_type,payload) ON scoped_outbox TO :"executor";
-- Explicit denial also clears old column grants. Inherited/SET ROLE and PUBLIC
-- access cannot be revoked from another principal here; guard rejects them.
REVOKE ALL PRIVILEGES ON broker_credential_vault FROM :"executor";
SELECT format($guard$
DO $role$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles r WHERE r.rolname=%1$L AND r.rolcanlogin
    AND NOT (r.rolsuper OR r.rolcreaterole OR r.rolcreatedb OR r.rolreplication OR r.rolbypassrls OR r.rolinherit)
    AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members m WHERE m.member=r.oid))
    OR pg_catalog.has_schema_privilege(%1$L,'public','CREATE')
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
      WHERE n.nspname='public' AND c.relkind IN ('r','v','m','p') AND
        pg_catalog.has_table_privilege(%1$L,c.oid,'INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN,SELECT WITH GRANT OPTION'))
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
      WHERE n.nspname='public' AND c.relkind IN ('r','v','m','p')
        AND c.relname NOT IN ('users','sessions','principals','resource_scopes','runtime_registration_challenges',
          'runtime_registrations','agent_connections','bootstrap_refresh_families','model_connections','broker_model_credentials',
          'model_broker_authorizations','execution_grants','execution_runs','execution_attempts','model_export_approvals',
          'model_text_steps','work_items','private_work_persistence_policy','model_inference_export_policy','assets','asset_objects',
          'asset_upload_intents','private_work_results','private_model_work_results','private_work_result_index','private_work_result_catalog',
          'private_work_result_targets','scoped_command_receipts','scoped_transition_journal','scoped_outbox')
        AND pg_catalog.has_any_column_privilege(%1$L,c.oid,'SELECT'))
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute a JOIN pg_catalog.pg_class c ON c.oid=a.attrelid
      JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace CROSS JOIN LATERAL pg_catalog.aclexplode(a.attacl) acl
      WHERE n.nspname='public' AND a.attnum>0 AND NOT a.attisdropped
        AND (acl.grantee=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=%1$L) AND acl.is_grantable
          OR acl.grantee=0 AND acl.privilege_type IN ('INSERT','UPDATE','REFERENCES')))
    OR pg_catalog.has_table_privilege(%1$L,'broker_credential_vault','SELECT')
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute a WHERE a.attrelid='broker_credential_vault'::regclass
      AND a.attnum>0 AND NOT a.attisdropped AND pg_catalog.has_column_privilege(%1$L,a.attrelid,a.attnum,'SELECT,INSERT,UPDATE,REFERENCES'))
    OR pg_catalog.has_any_column_privilege(%1$L,'broker_model_credentials','INSERT,UPDATE,REFERENCES')
    OR pg_catalog.has_any_column_privilege(%1$L,'model_broker_authorizations','INSERT,REFERENCES')
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute a WHERE a.attrelid='model_broker_authorizations'::regclass
      AND a.attnum>0 AND NOT a.attisdropped AND a.attname<>'accepted_at' AND pg_catalog.has_column_privilege(%1$L,a.attrelid,a.attnum,'UPDATE'))
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute a WHERE a.attrelid IN ('private_work_persistence_policy'::regclass,'model_inference_export_policy'::regclass)
      AND a.attnum>0 AND NOT a.attisdropped AND (pg_catalog.has_column_privilege(%1$L,a.attrelid,a.attnum,'INSERT,REFERENCES')
        OR a.attname<>'scope_kind' AND pg_catalog.has_column_privilege(%1$L,a.attrelid,a.attnum,'UPDATE')))
  THEN RAISE EXCEPTION 'Unsafe dedicated broker execution role'; END IF;
END $role$;
$guard$,:'executor')
\gexec
COMMIT;
