-- Read-only verification; safe to run as the migrator after every restore/migrate.
-- Prints counts and booleans only, never row contents.
--   psql "service=freedom_next_migrator" -v ON_ERROR_STOP=1 -v env_prefix=freedom_next -f 30-verify-readonly.psql
--
-- Extensions: the SELECT below lists every extension except plpgsql. It does not
-- CREATE or DROP anything, and an extra row is not by itself a failure.
-- Allowlist when reading that result (2026-09-25 production on PlanetScale):
--   plpgsql  — omitted by the filter; required for trigger functions
--   hypopg   — auto-installed by PlanetScale (schema pscale_extensions, owner pscale_admin)
-- Any "no extensions" check must allowlist hypopg. Do not treat it as schema drift.
-- The application does not install it. Other names are not on the allowlist.
\set migrator :env_prefix '_migrator'
\set runtime :env_prefix '_app'
SELECT current_setting('server_version_num')::int / 10000 AS pg_major;
SELECT rolname, rolsuper, rolcreaterole, rolcreatedb, rolbypassrls, rolreplication
  FROM pg_roles WHERE rolname IN (:'migrator', :'runtime') ORDER BY rolname;
SELECT has_schema_privilege(:'runtime', 'public', 'CREATE') AS runtime_can_create_in_public;
SELECT count(*) AS objects_owned_by_runtime FROM pg_class c JOIN pg_roles r ON r.oid = c.relowner WHERE r.rolname = :'runtime';
SELECT count(*) AS objects_not_owned_by_migrator FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace JOIN pg_roles r ON r.oid = c.relowner
  WHERE n.nspname = 'public' AND r.rolname <> :'migrator';
SELECT extname FROM pg_extension WHERE extname <> 'plpgsql' ORDER BY extname;
SELECT count(*) AS applied_migrations, min(name) AS first_migration, max(name) AS last_migration FROM schema_migrations;
SELECT count(*) AS local_demo_accounts FROM users WHERE email LIKE '%@local.test';
SELECT count(*) AS runtime_ledger_write FROM information_schema.role_table_grants
  WHERE grantee = :'runtime' AND table_name = 'schema_migrations' AND privilege_type IN ('INSERT', 'UPDATE', 'DELETE', 'TRUNCATE');
-- Effective privileges include inherited and PUBLIC ACLs, not just direct grants.
-- Expect one protected policy at 085--092 and two at 093+. Missing rows are not safety evidence.
-- BEGIN PRIVATE POLICY READBACK
SELECT has_table_privilege(:'runtime',c.oid,'SELECT') AS private_policy_read,
  has_column_privilege(:'runtime',c.oid,'scope_kind','UPDATE') AS private_policy_lock,
  EXISTS (SELECT 1 FROM pg_roles r WHERE r.rolname=:'runtime' AND
    (r.rolsuper OR r.rolcreaterole OR r.rolcreatedb OR r.rolreplication OR r.rolbypassrls
      OR EXISTS (SELECT 1 FROM pg_auth_members m WHERE m.member=r.oid)))
    OR NOT EXISTS (SELECT 1 FROM pg_attribute a JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
      WHERE a.attrelid=c.oid AND a.attname='scope_kind' AND a.attgenerated='s'
        AND pg_get_expr(d.adbin,d.adrelid)='''personal''::text')
    OR has_table_privilege(:'runtime',c.oid,'INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')
    OR EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped
      AND (has_column_privilege(:'runtime',c.oid,a.attnum,'INSERT,REFERENCES,SELECT WITH GRANT OPTION,UPDATE WITH GRANT OPTION')
        OR (a.attname<>'scope_kind' AND has_column_privilege(:'runtime',c.oid,a.attnum,'UPDATE')))) AS private_policy_unsafe
FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname='public' AND c.relname IN ('private_work_persistence_policy','model_inference_export_policy') AND c.relkind='r'
ORDER BY c.relname DESC;
-- END PRIVATE POLICY READBACK
-- BEGIN DOMAIN MEDIA POLICY READBACK
-- Exactly one row after migration098+; absence is unavailable, not safe.
-- The generated lock appears only at100+. Expected after grants: true,true,false.
SELECT has_table_privilege(:'runtime',c.oid,'SELECT') AS media_policy_read,
  has_column_privilege(:'runtime',c.oid,'policy_lock','UPDATE') AS media_policy_lock,
  EXISTS (SELECT 1 FROM pg_roles r WHERE r.rolname=:'runtime' AND
    (r.rolsuper OR r.rolcreaterole OR r.rolcreatedb OR r.rolreplication OR r.rolbypassrls
      OR EXISTS (SELECT 1 FROM pg_auth_members m WHERE m.member=r.oid)))
    OR NOT EXISTS (SELECT 1 FROM pg_attribute a JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
      WHERE a.attrelid=c.oid AND a.attname='policy_lock' AND a.attgenerated='s'
        AND pg_get_expr(d.adbin,d.adrelid)='0')
    OR has_table_privilege(:'runtime',c.oid,'INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')
    OR EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped
      AND (has_column_privilege(:'runtime',c.oid,a.attnum,'INSERT,REFERENCES,SELECT WITH GRANT OPTION,UPDATE WITH GRANT OPTION')
        OR (a.attname<>'policy_lock' AND has_column_privilege(:'runtime',c.oid,a.attnum,'UPDATE')))) AS media_policy_unsafe
FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname='public' AND c.relname='domain_media_storage_policy' AND c.relkind='r';
-- END DOMAIN MEDIA POLICY READBACK
