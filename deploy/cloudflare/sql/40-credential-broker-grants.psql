-- Opt-in only, after 114. Provision a dedicated <env_prefix>_broker LOGIN with
-- NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT and no
-- memberships outside migrations. No password, KEK or installed host here.
-- Run as the schema-owning migrator; never as public/maintainer/media runtime.
\set broker :env_prefix '_broker'
BEGIN;
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM :"broker";
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM :"broker";
-- BEGIN BROKER COLUMN RESET
SELECT format('REVOKE ALL PRIVILEGES (%s) ON TABLE %s FROM %I;',
  (SELECT string_agg(quote_ident(a.attname),',' ORDER BY a.attnum) FROM pg_catalog.pg_attribute a
    WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped),c.oid::regclass,:'broker')
FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname='public' AND c.relkind='r'
\gexec
-- END BROKER COLUMN RESET
GRANT USAGE ON SCHEMA public TO :"broker";
GRANT SELECT ON users,sessions,principals,resource_scopes,runtime_registrations,agent_connections,
  bootstrap_refresh_families,model_connections,broker_model_credentials,broker_credential_vault,
  scoped_command_receipts,scoped_transition_journal TO :"broker";
-- Current original-member bridge authorization is metadata only. Cipher
-- custody does not grant Step/Asset execution writes; that uses role 45.
GRANT SELECT ON model_broker_authorizations,model_export_approvals,execution_grants,
  execution_runs,work_items,model_text_steps TO :"broker";
GRANT UPDATE(accepted_at) ON model_broker_authorizations TO :"broker";
GRANT SELECT,INSERT ON credential_ingest_preparations TO :"broker";
GRANT SELECT ON credential_ingest_authorizations TO :"broker";
GRANT UPDATE(bootstrap_claimed_at,setup_cookie_hash,setup_csrf_hash,setup_expires_at,
  submission_claimed_at,write_expires_at,submitted_credential_id,submitted_binding,
  committed_at,committed_credential_id) ON credential_ingest_authorizations TO :"broker";
-- PostgreSQL FOR SHARE/UPDATE requires UPDATE on at least one column. These
-- invoker rights are intentionally narrow; existing domain triggers still fence
-- identity/state changes. They are not a member authorization substitute.
GRANT UPDATE(active) ON users TO :"broker";
GRANT UPDATE(revoked_at) ON sessions TO :"broker";
GRANT UPDATE(status),INSERT ON principals,resource_scopes TO :"broker";
GRANT UPDATE(state) ON runtime_registrations,agent_connections,bootstrap_refresh_families TO :"broker";
GRANT UPDATE(state,aggregate_version,revoked_at) ON model_connections TO :"broker";
GRANT INSERT ON broker_model_credentials,broker_credential_vault,scoped_command_receipts,scoped_transition_journal TO :"broker";
GRANT UPDATE(state,aggregate_version,terminal_at,replacement_credential_id) ON broker_model_credentials TO :"broker";
-- BEGIN BROKER ROLE GUARD
SELECT format($guard$
DO $role$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles r WHERE r.rolname=%1$L AND r.rolcanlogin
    AND NOT (r.rolsuper OR r.rolcreaterole OR r.rolcreatedb OR r.rolreplication OR r.rolbypassrls OR r.rolinherit)
    AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members m WHERE m.member=r.oid))
    OR pg_catalog.has_schema_privilege(%1$L,'public','CREATE')
    OR pg_catalog.has_table_privilege(%1$L,'broker_credential_vault','UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN,SELECT WITH GRANT OPTION,INSERT WITH GRANT OPTION')
    OR EXISTS(SELECT 1 FROM pg_catalog.pg_attribute a WHERE a.attrelid='broker_credential_vault'::regclass
      AND a.attnum>0 AND NOT a.attisdropped AND pg_catalog.has_column_privilege(%1$L,a.attrelid,a.attnum,'UPDATE,REFERENCES,SELECT WITH GRANT OPTION,INSERT WITH GRANT OPTION'))
    OR pg_catalog.has_table_privilege(%1$L,'model_broker_authorizations','INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')
    OR pg_catalog.has_any_column_privilege(%1$L,'model_broker_authorizations','INSERT,REFERENCES')
    OR EXISTS(SELECT 1 FROM pg_catalog.pg_attribute a WHERE a.attrelid='model_broker_authorizations'::regclass
      AND a.attnum>0 AND NOT a.attisdropped AND a.attname<>'accepted_at' AND pg_catalog.has_column_privilege(%1$L,a.attrelid,a.attnum,'UPDATE'))
    OR pg_catalog.has_table_privilege(%1$L,'credential_ingest_preparations','UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN,SELECT WITH GRANT OPTION,INSERT WITH GRANT OPTION')
    OR pg_catalog.has_any_column_privilege(%1$L,'credential_ingest_preparations','UPDATE,REFERENCES,SELECT WITH GRANT OPTION,INSERT WITH GRANT OPTION')
    OR pg_catalog.has_table_privilege(%1$L,'credential_ingest_authorizations','INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN,SELECT WITH GRANT OPTION')
    OR pg_catalog.has_any_column_privilege(%1$L,'credential_ingest_authorizations','INSERT,REFERENCES,SELECT WITH GRANT OPTION,UPDATE WITH GRANT OPTION')
    OR EXISTS(SELECT 1 FROM pg_catalog.pg_attribute a WHERE a.attrelid='credential_ingest_authorizations'::regclass
      AND a.attnum>0 AND NOT a.attisdropped AND a.attname NOT IN ('bootstrap_claimed_at','setup_cookie_hash','setup_csrf_hash','setup_expires_at',
        'submission_claimed_at','write_expires_at','submitted_credential_id','submitted_binding','committed_at','committed_credential_id')
      AND pg_catalog.has_column_privilege(%1$L,a.attrelid,a.attnum,'UPDATE'))
    OR EXISTS(SELECT 1 FROM pg_catalog.pg_class c,LATERAL pg_catalog.aclexplode(COALESCE(c.relacl,pg_catalog.acldefault('r',c.relowner))) acl
      WHERE c.oid IN ('credential_ingest_authorizations'::regclass,'credential_ingest_preparations'::regclass) AND acl.grantee=0)
    OR EXISTS(SELECT 1 FROM pg_catalog.pg_attribute a,LATERAL pg_catalog.aclexplode(a.attacl) acl
      WHERE a.attrelid IN ('credential_ingest_authorizations'::regclass,'credential_ingest_preparations'::regclass) AND a.attnum>0 AND NOT a.attisdropped AND acl.grantee=0)
  THEN RAISE EXCEPTION 'Unsafe dedicated broker role'; END IF;
END $role$;
$guard$,:'broker')
\gexec
-- END BROKER ROLE GUARD
COMMIT;
