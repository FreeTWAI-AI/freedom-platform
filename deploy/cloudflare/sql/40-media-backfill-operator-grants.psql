-- Explicit dedicated operator installation only; this does NOT approve a plan,
-- change storage consent, create a role, or run/cut over/purge any backfill.
-- psql SERVICE -v ON_ERROR_STOP=1 -v operator_role=freedom_media_migrator -v operator_schema=public -f 40-media-backfill-operator-grants.psql
\if :{?operator_role}
\else
\quit 2
\endif
\if :{?operator_schema}
\else
\quit 2
\endif
BEGIN;
SELECT set_config('freedom.operator_role', :'operator_role',true),set_config('freedom.operator_schema', :'operator_schema',true);
-- BEGIN CLOSED OPERATOR GRANTS
DO $operator$
DECLARE r text:=current_setting('freedom.operator_role');s text:=current_setting('freedom.operator_schema');
 t text;c text;columns text;roid oid;
BEGIN
 IF r !~ '^(fp_media_migrator_[a-z0-9_]+|freedom_media_migrator)$' OR s !~ '^[a-z_][a-z0-9_]{0,62}$' THEN RAISE EXCEPTION 'Invalid dedicated operator target';END IF;
 SELECT oid INTO roid FROM pg_roles WHERE rolname=r AND rolcanlogin AND NOT rolsuper AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolreplication AND NOT rolbypassrls;
 IF roid IS NULL OR EXISTS(SELECT 1 FROM pg_auth_members WHERE member=roid) OR has_schema_privilege(r,s,'CREATE') THEN RAISE EXCEPTION 'Unsafe dedicated operator role';END IF;
 FOR t IN SELECT unnest(ARRAY['media_backfill_operator_policy','media_backfill_jobs','media_backfill_items','media_backfill_audit','member_services','member_service_covers','member_service_cover_asset_targets','community_events','community_event_videos','community_event_video_asset_targets','community_event_banners','community_event_banner_asset_targets','community_social_posts','community_social_post_thumbnails','community_social_thumbnail_asset_targets','assets','asset_objects','asset_upload_intents']) LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname=s AND c.relname=t AND c.relkind IN ('r','p') AND NOT c.relrowsecurity AND c.relowner<>roid) THEN RAISE EXCEPTION 'Operator source shape unavailable';END IF;
  SELECT string_agg(quote_ident(a.attname),',') INTO columns FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname=s AND c.relname=t AND a.attnum>0 AND NOT a.attisdropped;
  EXECUTE format('REVOKE ALL PRIVILEGES ON TABLE %I.%I FROM %I',s,t,r);
  EXECUTE format('REVOKE ALL PRIVILEGES (%s) ON TABLE %I.%I FROM %I',columns,s,t,r);
 END LOOP;
 EXECUTE format('GRANT USAGE ON SCHEMA %I TO %I',s,r);
 -- 108 effect evidence is capability-bound by the trusted host; no approval
 -- or owner authority is added. The immutable source coverage flag is explicit
 -- on new asset INSERT only; old assets can never be UPDATE-adopted.
 IF to_regclass(format('%I.asset_object_write_effects',s)) IS NOT NULL THEN
  EXECUTE format('GRANT SELECT(effect_id,settlement_nonce,state) ON %I.asset_object_write_effects TO %I',s,r);
  EXECUTE format('GRANT INSERT(effect_id,intent_id,asset_id,intent_fence,settlement_nonce),UPDATE(state,finished_at) ON %I.asset_object_write_effects TO %I',s,r);
 END IF;
 FOREACH t IN ARRAY ARRAY['media_backfill_jobs','media_backfill_items','media_backfill_audit','member_services','member_service_covers','member_service_cover_asset_targets','community_events','community_event_videos','community_event_video_asset_targets','community_event_banners','community_event_banner_asset_targets','community_social_posts','community_social_post_thumbnails','community_social_thumbnail_asset_targets','assets','asset_objects','asset_upload_intents'] LOOP
  EXECUTE format('GRANT SELECT ON %I.%I TO %I',s,t,r);
 END LOOP;
 EXECUTE format('GRANT SELECT(policy_id,allowed,expires_at) ON %I.media_backfill_operator_policy TO %I',s,r);
 FOREACH t IN ARRAY ARRAY['media_backfill_jobs','media_backfill_items','media_backfill_audit','member_service_cover_asset_targets','community_event_video_asset_targets','community_event_banner_asset_targets','community_social_thumbnail_asset_targets','assets','asset_objects','asset_upload_intents'] LOOP
  EXECUTE format('GRANT INSERT ON %I.%I TO %I',s,t,r);
 END LOOP;
 EXECUTE format('GRANT UPDATE(after_service_id,after_event_id,after_banner_event_id,after_post_id,fence,lease_token,lease_expires_at,completed) ON %I.media_backfill_jobs TO %I',s,r);
 EXECUTE format('GRANT UPDATE(outcome,finished_at) ON %I.media_backfill_items TO %I',s,r);
 EXECUTE format('GRANT UPDATE(aggregate_version,updated_at) ON %I.member_services TO %I',s,r);
 -- Original read lock needs one UPDATE column; bytes/source remain unwritable.
 EXECUTE format('GRANT UPDATE(updated_at) ON %I.member_service_covers TO %I',s,r);
 EXECUTE format('GRANT UPDATE(asset_id,linked_at_version) ON %I.member_service_cover_asset_targets TO %I',s,r);
 EXECUTE format('GRANT UPDATE(aggregate_version,updated_at) ON %I.community_events TO %I',s,r);
 EXECUTE format('GRANT UPDATE(updated_at) ON %I.community_event_videos TO %I',s,r);
 EXECUTE format('GRANT UPDATE(asset_id,linked_at_version) ON %I.community_event_video_asset_targets TO %I',s,r);
 EXECUTE format('GRANT UPDATE(updated_at) ON %I.community_event_banners TO %I',s,r);
 EXECUTE format('GRANT UPDATE(asset_id,linked_at_version) ON %I.community_event_banner_asset_targets TO %I',s,r);
 EXECUTE format('GRANT UPDATE(media_version,updated_at) ON %I.community_social_posts TO %I',s,r);
 EXECUTE format('GRANT UPDATE(updated_at) ON %I.community_social_post_thumbnails TO %I',s,r);
 EXECUTE format('GRANT UPDATE(asset_id,linked_at_version) ON %I.community_social_thumbnail_asset_targets TO %I',s,r);
 EXECUTE format('GRANT UPDATE(state,ready_at) ON %I.assets TO %I',s,r);
 EXECUTE format('GRANT UPDATE(fence,lease_token,lease_expires_at,state,finalized_at) ON %I.asset_upload_intents TO %I',s,r);
 EXECUTE format('GRANT USAGE ON SEQUENCE %s TO %I',pg_get_serial_sequence(format('%I.media_backfill_audit',s),'audit_id'),r);
 FOREACH c IN ARRAY ARRAY['lock_media_backfill_operator_approval(text)','lock_media_backfill_cover_owner(text,uuid)','lock_media_backfill_cover_consent(text)','publish_media_backfill_cover(text,uuid,uuid,bigint,uuid)','lock_media_backfill_video_organizer(text,uuid)','lock_media_backfill_video_consent(text)','publish_media_backfill_video(text,uuid,uuid,bigint,uuid)','lock_media_backfill_banner_organizer(text,uuid)','lock_media_backfill_banner_consent(text)','publish_media_backfill_banner(text,uuid,uuid,bigint,uuid)','lock_media_backfill_social_author(text,uuid)','lock_media_backfill_social_consent(text)','publish_media_backfill_social(text,uuid,uuid,bigint,uuid)'] LOOP
  EXECUTE format('GRANT EXECUTE ON FUNCTION %I.%s TO %I',s,c,r);
 END LOOP;
 -- Inherited/PUBLIC rights cannot be removed by a target-role REVOKE.
 FOREACH t IN ARRAY ARRAY['media_backfill_operator_policy','domain_media_storage_policy','users','principals','resource_scopes'] LOOP
  IF has_table_privilege(r,format('%I.%I',s,t),'INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')
  OR EXISTS(SELECT 1 FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname=s AND c.relname=t AND a.attnum>0 AND NOT a.attisdropped AND has_column_privilege(r,c.oid,a.attnum,'INSERT,UPDATE,REFERENCES')) THEN RAISE EXCEPTION 'Unsafe operator authority privileges';END IF;
 END LOOP;
END $operator$;
-- END CLOSED OPERATOR GRANTS
COMMIT;
