{
  "name": "freedom-platform",
  "version": "0.13.0-member-messages",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "build": "node scripts/generate-runtime-text.mjs --check && node scripts/build-skill-upload-client.mjs && vite build --config apps/portal-web/vite.config.ts",
    "start": "tsx apps/platform-api/src/server.ts",
    "generate:runtime-text": "node scripts/generate-runtime-text.mjs",
    "check:runtime-text": "node scripts/generate-runtime-text.mjs --check",
    "worker:dry-run": "node scripts/generate-runtime-text.mjs --check && wrangler deploy --dry-run --env \"\" --outdir .wrangler/dry-run/local && wrangler deploy --dry-run --env staging-next --outdir .wrangler/dry-run/staging-next && wrangler deploy --dry-run --env next --outdir .wrangler/dry-run/next",
    "worker:dry-run:admin-sync": "wrangler deploy --dry-run --config wrangler.admin-sync.jsonc --env \"\" --outdir .wrangler/dry-run/admin-sync-local && wrangler deploy --dry-run --config wrangler.admin-sync.jsonc --env staging-next --outdir .wrangler/dry-run/admin-sync-staging-next && wrangler deploy --dry-run --config wrangler.admin-sync.jsonc --env next --outdir .wrangler/dry-run/admin-sync-next",
    "worker:dry-run:maintainer": "wrangler deploy --dry-run --config wrangler.maintainer.jsonc --env \"\" --outdir .wrangler/dry-run/maintainer-local && wrangler deploy --dry-run --config wrangler.maintainer.jsonc --env staging-next --outdir .wrangler/dry-run/maintainer-staging-next && wrangler deploy --dry-run --config wrangler.maintainer.jsonc --env next --outdir .wrangler/dry-run/maintainer-next",
    "test:worker": "node -e 0",
    "dev": "vite --config apps/portal-web/vite.config.ts",
    "demo": "npm run db:up && npm run db:migrate && npm run db:seed && npm run build && npm start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/runtime/*.test.ts",
    "test:skill-client": "node --test packages/skill-upload-client/test/*.test.mjs",
    "test:governance": "node -e 0",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:contracts": "node -e 0",
    "verify:inventory": "python3 docs/platform-plan/verification/verify_revision.py",
    "contracts:build": "node scripts/build-contract-bundle.mjs",
    "contracts:common": "tsx scripts/build-common-contracts.ts",
    "check:common-contracts": "tsx scripts/build-common-contracts.ts --check",
    "contracts:execution": "tsx packages/execution-state/generate.ts",
    "check:execution-contracts": "tsx packages/execution-state/generate.ts --check",
    "contracts:runtime-registration": "tsx modules/agent-control/generate.ts",
    "check:runtime-registration": "tsx modules/agent-control/generate.ts --check",
    "contracts:bootstrap": "tsx modules/agent-control/generate-bootstrap.ts",
    "check:bootstrap": "tsx modules/agent-control/generate-bootstrap.ts --check",
    "contracts:device-pairing": "tsx modules/agent-control/generate-device-pairing.ts",
    "check:device-pairing": "tsx modules/agent-control/generate-device-pairing.ts --check",
    "contracts:bootstrap-session": "tsx modules/agent-control/generate-bootstrap-session.ts",
    "check:bootstrap-session": "tsx modules/agent-control/generate-bootstrap-session.ts --check",
    "test:repos": "tsx --test --test-concurrency=1 tests/integration/repositories.test.ts tests/integration/consumer-libraries.test.ts",
    "check:skill-book-upstreams": "tsx scripts/check-skill-book-upstreams.ts",
    "contracts:bootstrap-http": "tsx modules/agent-control/generate-bootstrap-http.ts",
    "check:bootstrap-http": "tsx modules/agent-control/generate-bootstrap-http.ts --check",
    "contracts:member-execution": "tsx modules/agent-execution/generate-member-execution.ts",
    "check:member-execution": "tsx modules/agent-execution/generate-member-execution.ts --check",
    "contracts:member-execution-http": "tsx modules/agent-execution/generate-member-execution-http.ts",
    "check:member-execution-http": "tsx modules/agent-execution/generate-member-execution-http.ts --check",
    "contracts:guild-launchpad": "tsx modules/guild-workspace/generate-contracts.ts",
    "check:guild-launchpad-contracts": "tsx modules/guild-workspace/generate-contracts.ts --check",
    "contracts:model-step": "tsx modules/agent-execution/generate-model-step.ts",
    "check:model-step-contracts": "tsx modules/agent-execution/generate-model-step.ts --check",
    "contracts:member-model-http": "tsx modules/agent-execution/generate-member-model-http.ts",
    "check:member-model-http": "tsx modules/agent-execution/generate-member-model-http.ts --check",
    "contracts:model-credential": "tsx modules/agent-execution/generate-model-credential.ts",
    "check:model-credential": "tsx modules/agent-execution/generate-model-credential.ts --check",
    "contracts:model-broker-bridge": "tsx modules/agent-control/generate-model-broker-bridge.ts",
    "check:model-broker-bridge": "tsx modules/agent-control/generate-model-broker-bridge.ts --check",
    "contracts:model-credential-ingest": "tsx modules/agent-control/generate-model-credential-ingest.ts",
    "check:model-credential-ingest": "tsx modules/agent-control/generate-model-credential-ingest.ts --check",
    "contracts:member-model-settings": "tsx modules/agent-execution/generate-member-model-settings.ts",
    "check:member-model-settings": "tsx modules/agent-execution/generate-member-model-settings.ts --check",
    "media:inventory": "tsx scripts/media-inventory.ts",
    "media:verify": "tsx scripts/media-verify.ts",
    "media:backfill": "tsx scripts/media-backfill.ts",
    "worker:dry-run:broker": "wrangler deploy --dry-run --config wrangler.broker.example.jsonc --env staging-next --outdir .wrangler/dry-run/broker-staging-next && wrangler deploy --dry-run --config wrangler.broker.example.jsonc --env next --outdir .wrangler/dry-run/broker-next",
    "check:broker-worker-candidate": "node deploy/cloudflare/broker-preflight.mjs",
    "test:media-restore": "node scripts/run-media-restore-test.mjs",
    "media:restore-acl": "tsx scripts/media-restore-acl.ts",
    "media:worker-preflight": "node -- deploy/cloudflare/media-preflight.mjs",
    "worker:dry-run:media-operator": "wrangler deploy --dry-run --config wrangler.media-operator.example.jsonc --env \"\" --outdir .wrangler/dry-run/media-operator-local && wrangler deploy --dry-run --config wrangler.media-operator.example.jsonc --env staging-next --outdir .wrangler/dry-run/media-operator-staging-next && wrangler deploy --dry-run --config wrangler.media-operator.example.jsonc --env next --outdir .wrangler/dry-run/media-operator-next",
    "guide:publish-plan": "node --import tsx scripts/guide-pack-publish-plan.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "html-to-image": "1.11.13",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260924.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "jsqr": "1.4.0",
    "miniflare": "5.20260921.1-alpha",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.138.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.1",
      "sharp": "$sharp"
    }
  }
}
