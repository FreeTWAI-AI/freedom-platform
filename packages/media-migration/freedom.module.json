  "surfaces": [
    {
      "surface_id": "operations.media-operator-rpc",
      "kind": "native",
      "entry": "apps/media-operator/src/worker.ts",
      "operations": ["media.operator.execute"],
      "auth_profile": "private-service-binding-approved-plan"
    },
    {
      "surface_id": "operations.media-inventory",
      "kind": "cli",
      "entry": "scripts/media-inventory.ts",
      "operations": [
        "media.inventory"
      ],
      "auth_profile": "operator-readonly"
    },
    {
      "surface_id": "operations.media-verify",
      "kind": "cli",
      "entry": "scripts/media-verify.ts",
      "operations": [
        "media.verify"
      ],
      "auth_profile": "operator-readonly"
    },
    {
      "surface_id": "operations.media-backfill",
      "kind": "cli",
      "entry": "scripts/media-backfill.ts",
      "operations": [
        "media.backfill"
      ],
      "auth_profile": "operator-approved-plan"
    },
    {
      "surface_id": "operations.media-restore-acl",
      "kind": "cli",
      "entry": "scripts/media-restore-acl.ts",
      "operations": [
        "media.restore-acl"
      ],
      "auth_profile": "operator-canonical-lockdown"
    },
    {
      "surface_id": "operations.media-backup-daily",
      "kind": "cli",
      "entry": "scripts/media-backup-daily.ts",
      "operations": [
        "media.backup-daily"
