  "public_exports": [
    "packages/media-migration/inventory.ts"
  ],
  "dependencies": ["command-core", "asset-storage", "assets", "resource-scopes"],
  "contract_families": [
    "common"
  ],
  "client_profiles": [],
  "instructions": [
    "packages/media-migration/README.md",
    "docs/platform-plan/execution/unified-foundation/05-media-migration.md"
  ],
  "invariants": [
    "explicit-readonly-target",
    "aggregate-only-report",
    "no-media-bytes-export",
    "inventory-is-not-migration-proof"
  ],
  "tests": [
    "runtime.full"
