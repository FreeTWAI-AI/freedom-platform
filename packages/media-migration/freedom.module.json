      "surface_id": "operations.media-backup-retention",
      "kind": "cli",
      "entry": "scripts/media-backup-retention.ts",
      "operations": [
        "media.backup-retention-plan"
      ],
      "auth_profile": "operator-explicit-readonly-archive"
    },
    {
      "surface_id": "operations.media-restore-drill",
      "kind": "cli",
      "entry": "scripts/run-media-restore-test.mjs",
      "operations": [
        "media.restore-drill"
      ],
      "auth_profile": "owned-isolated-test-container"
    },
    {
      "surface_id": "operations.media-recovery-restore",
      "kind": "cli",
      "entry": "scripts/media-recovery-restore.ts",
      "operations": [
        "media.recovery-restore"
      ],
      "auth_profile": "operator-explicit-expected-identity"
    }
  ]
